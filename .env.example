# 31337 = local devnet (anvil on :8547), 46630 = Robinhood Chain testnet, 4663 = mainnet
NEXT_PUBLIC_CHAIN_ID=4663
# Optional RPC override (defaults: local :8547 / official Robinhood RPCs)
NEXT_PUBLIC_RPC_URL=
# 1 = show demo data instead of reading the chain
NEXT_PUBLIC_DEMO=0
# Indexer API (indexer/, run with the same CHAIN_ID, e.g. https://api.kyte.sh). Leave empty to read the chain directly from the browser.
NEXT_PUBLIC_INDEXER_URL=
# Privy app id (wallet picker, installed wallets only). Add http://localhost:3010 to the app's allowed origins in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# Public URL, used for Open Graph images
NEXT_PUBLIC_SITE_URL=http://localhost:3010
